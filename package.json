{
  "name": "potencia-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop interface for Potencia Runtime",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package:dir": "npm run rebuild && npm run build && electron-builder --dir",
    "package:win": "npm run rebuild && npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@xterm/xterm": "^5.3.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.4",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.potencia.desktop",
    "productName": "Potencia Desktop",
    "artifactName": "Potencia-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Potencia-Desktop-${version}-portable.${ext}"
    }
  }
}
